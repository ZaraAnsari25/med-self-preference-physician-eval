# Postgres connection string for staging/production. When unset, the app uses an
# embedded PGlite database stored in ./.data/pglite (local development only).
DATABASE_URL=

# Optional override for the PGlite directory used when DATABASE_URL is unset.
PGLITE_DIR=./.data/pglite

# Set to "true" when serving over HTTPS so session cookies are marked Secure.
COOKIE_SECURE=false
