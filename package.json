{
  "name": "med-self-preference-physician-eval",
  "version": "0.1.0",
  "private": true,
  "description": "Blinded physician evaluation platform for the Medical LLM self-preference study",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "data:fetch": "tsx scripts/fetch-source.ts",
    "data:prepare": "tsx scripts/prepare-data.ts && tsx scripts/prepare-medsp1000.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:import": "tsx scripts/import-bundle.ts",
    "user:create": "tsx scripts/create-user.ts",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "test:e2e": "tsx scripts/e2e-prototype.ts",
    "demo": "npm run data:fetch && npm run data:prepare && npm run demo:seed && next build && next start -p 3123",
    "study:setup": "PGLITE_DIR=./.data/study tsx scripts/setup-study.ts",
    "study:start": "PGLITE_DIR=./.data/study next start -p 3123"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electric-sql/pglite": "^0.3.16",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
